<% layout("/layouts/boilerplate")%> 

<div class="row mt-3">
  <div class="col-8 offset-3">
      <h3><%= listing.title %> </h3>
   <div class="card col-6 offset-3">
   </div>
  <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body">
    <p class="card-text">
     
      <%= listing.description %> <br>
      &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
      <%= listing.location %> <br>
      <%= listing.country %> <br>
    </p>
  
</div>
   </div>
 


<div class="btns">
 <a href="/listings/<%= listing._id %>/edit " class="btn btn-dark  col-1  offset-3 edit-btn"><b>Edit</b>  </a>


<form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
  <button class="btn btn-dark offset-5"> DELETE </button>
</form>
</div> 

<div class="col-8 offset-3 mb-3">
  <hr/>
  <h4>Leave a Review
  </h4>
  <form >
   <div class="mb-3 mt-3">
    <label for="rating">Rating</label>
    <input type="range"  min="1" max="5" name="review[rating]" id="rating" class="form-range">
   </div>
   <div class="mb-3 mt-3">
    <label for="comment" class="form-label">Comments</label>
    <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"></textarea>
   </div>
   <button class="btn btn-outline-dark">Submit</button>
  </form>
</div>

</div>
